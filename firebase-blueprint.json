{
  "entities": {
    "Simulation": {
      "title": "Simulation",
      "description": "A saved loan simulation",
      "type": "object",
      "properties": {
        "amount": { "type": "number", "description": "Loan amount" },
        "annualInterestRate": { "type": "number", "description": "Annual nominal interest rate" },
        "termMonths": { "type": "number", "description": "Loan term in months" },
        "startDate": { "type": "string", "description": "Start date of the loan" },
        "openingFeeType": { "type": "string", "enum": ["percent", "fixed"], "description": "Type of opening fee" },
        "openingFeeValue": { "type": "number", "description": "Value of the opening fee" },
        "isOpeningFeeFinanced": { "type": "boolean", "description": "Whether the opening fee is financed" },
        "insuranceSinglePremium": { "type": "number", "description": "Single premium insurance amount" },
        "isInsuranceFinanced": { "type": "boolean", "description": "Whether the insurance is financed" },
        "recurringMonthlyCosts": { "type": "number", "description": "Other recurring monthly costs" },
        "userProvidedApr": { "type": "number", "description": "APR provided by the user" },
        "id": { "type": "string", "description": "Unique identifier" },
        "shortCode": { "type": "string", "description": "Short code for sharing" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "Expiration timestamp (7 days after creation)" },
        "userName": { "type": "string", "description": "Name of the user" },
        "userEmail": { "type": "string", "description": "Email of the user" }
      },
      "required": [
        "amount",
        "annualInterestRate",
        "termMonths",
        "startDate",
        "openingFeeType",
        "openingFeeValue",
        "isOpeningFeeFinanced",
        "insuranceSinglePremium",
        "isInsuranceFinanced",
        "recurringMonthlyCosts",
        "id",
        "shortCode",
        "createdAt",
        "expiresAt",
        "userName",
        "userEmail"
      ]
    }
  },
  "firestore": {
    "simulations/{simulationId}": {
      "schema": "Simulation",
      "description": "Collection of loan simulations"
    }
  }
}
