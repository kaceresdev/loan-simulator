rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSimulation(data) {
      return data.amount is number
        && data.annualInterestRate is number
        && data.termMonths is number
        && data.id is string
        && data.shortCode is string;
    }

    match /simulations/{simulationId} {
      allow get: if true;
      allow create: if isValidId(simulationId)
        && simulationId.size() == 6
        && request.resource.data.id == simulationId
        && request.resource.data.shortCode == simulationId
        && request.resource.data.amount is number
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp;
      allow update, delete: if false;
    }
  }
}
